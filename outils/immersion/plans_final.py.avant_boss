# tableaux convertis en machines de Create : (sujet, titre FR, titre EN)
CREATE = {
 "aztec": ("manivelle", "Manivelle", "Hand Crank"), "bomb": ("bruleur", "Brûleur à blaze", "Blaze Burner"),
 "kebab": ("boite", "Boîte à engrenages", "Gearbox"), "plant": ("cle_create", "Clé de l'ingénieur", "Engineer's Wrench"),
 "wasteland": ("ventilo", "Ventilateur à carter", "Encased Fan"),
 "sunset": ("tapis", "Tapis roulant", "Mechanical Belt"), "sea": ("scie", "Scie mécanique", "Mechanical Saw"),
 "void": ("moteur", "Moteur à vapeur", "Steam Engine"), "match": ("coucou", "Horloge à coucou", "Cuckoo Clock"),
 "wind": ("meule", "Meule", "Millstone"),
 "tides": ("mixeur", "Mélangeur mécanique", "Mechanical Mixer"), "cotan": ("concasseur", "Roues de concassage", "Crushing Wheels"),
 "fern": ("presse_create", "Presse mécanique", "Mechanical Press"), "owlemons": ("foreuse_create", "Perceuse mécanique", "Mechanical Drill"),
}
PLANCHES.update(CREATE)

def generer(nom, w, h):
    return planche(w*64, h*64, SUJETS, PLANCHES[nom][0], graine=sum(map(ord, nom)))

if __name__ == "__main__":
    from tableaux4 import SPEC
    os.makedirs("painting7", exist_ok=True); ims = []
    for nom in PLANCHES:
        w, h = SPEC[nom][:2]; im = generer(nom, w, h); im.save(f"painting7/{nom}.png"); ims.append((w*h, w, im))
    for nom in CONSERVES: os.system(f"cp painting4/{nom}.png painting7/{nom}.png")
    ims.sort(key=lambda t: (t[0], t[1]))
    W = 1500; x = y = 10; rowh = 0; c = Image.new("RGB", (W, 5000), (36, 34, 38))
    for _, _, im in ims:
        z = 2 if im.width <= 128 and im.height <= 128 else 1
        im = im.resize((im.width*z, im.height*z), Image.NEAREST)
        if x + im.width > W - 10: x = 10; y += rowh + 10; rowh = 0
        c.paste(im, (x, y)); x += im.width + 10; rowh = max(rowh, im.height)
    c.crop((0, 0, W, y + rowh + 10)).save("/home/claude/apercus/plans_v7.png")
