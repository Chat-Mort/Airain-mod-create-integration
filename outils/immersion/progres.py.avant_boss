# Progrès impossibles dans l'Empire : pas de villageois, de raids, de pillards ni de zombies villageois (voir la Bible).
MASQUES = ["adventure.trade", "adventure.trade_at_world_height", "adventure.hero_of_the_village", "adventure.voluntary_exile",
           "adventure.whos_the_pillager_now", "adventure.very_very_frightening", "adventure.lightning_rod_with_villager_no_fire",
           "story.cure_zombie_villager"]
# Mobs retirés de « Démantèlement complet » (sinon impossible à terminer)
RETIRES = {"minecraft:evoker", "minecraft:pillager", "minecraft:ravager", "minecraft:vex", "minecraft:vindicator", "minecraft:witch", "minecraft:zombie_villager", "minecraft:illusioner"}

def main(pack):
    V = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "mcmeta-data", "data", "minecraft", "advancement")
    A = os.path.join(pack, "kubejs", "assets", "minecraft", "lang")
    D = os.path.join(pack, "kubejs", "data", "minecraft", "advancement")
    for code, k in (("fr_fr", 0), ("en_us", 2)):
        p = os.path.join(A, code + ".json"); j = json.load(open(p)) if os.path.exists(p) else {}
        for cle, v in P.items():
            j[f"advancements.{cle}.title"] = v[k]; j[f"advancements.{cle}.description"] = v[k + 1]
        json.dump(j, open(p, "w"), ensure_ascii=False, indent=2)
    # masquer : on garde le progrès (les autres peuvent en dépendre) mais sans affichage ni critère atteignable
    for cle in MASQUES:
        cat, nom = cle.split(".")
        src = json.load(open(os.path.join(V, cat, nom + ".json")))
        src.pop("display", None)
        os.makedirs(os.path.join(D, cat), exist_ok=True)
        json.dump(src, open(os.path.join(D, cat, nom + ".json"), "w"), indent=2)
    # démantèlement complet : sans les humains retirés
    src = json.load(open(os.path.join(V, "adventure", "kill_all_mobs.json")))
    for c in list(src["criteria"]):
        if c in RETIRES: del src["criteria"][c]
    src["requirements"] = [[c] for c in src["criteria"]]
    os.makedirs(os.path.join(D, "adventure"), exist_ok=True)
    json.dump(src, open(os.path.join(D, "adventure", "kill_all_mobs.json"), "w"), indent=2)
    print(len(P), "progrès renommés,", len(MASQUES), "masqués,", "démantèlement :", len(src["criteria"]), "automates")

if __name__ == "__main__":
    main(sys.argv[1])
